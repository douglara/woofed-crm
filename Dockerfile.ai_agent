# Standalone container for the Woofed CRM AI agent (agno + Woofed MCP).
#
# Build (from the repo root):
#   docker build -f Dockerfile.ai_agent -t woofed-agent .
#
# Run:
#   docker run -p 7777:7777 \
#     -e FRONTEND_URL=http://host.docker.internal:3000 \
#     -e WOOFED_AI_DATABASE_URL=postgres://postgres:password@host.docker.internal/ \
#     -e OS_SECURITY_KEY=a-long-random-secret \
#     woofed-agent
#
# Required env at runtime:
#   FRONTEND_URL   Public URL of the Rails app (the agent calls <FRONTEND_URL>/mcp)
#   WOOFED_AI_DATABASE_URL   Agno Postgres URL
#   OS_SECURITY_KEY   Static bearer token every API caller must send (agno basic auth)

FROM python:3.12-slim AS base

# uv (Astral's Python package manager) — matches the dev setup.
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /usr/local/bin/

# libpq for psycopg's runtime; curl for HEALTHCHECK.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Layer 1: dependencies (cached unless lockfile or manifest change).
COPY ai-agent/pyproject.toml ai-agent/uv.lock ./
RUN uv sync --frozen --no-install-project

# Layer 2: agent source.
COPY ai-agent/main.py ./

ENV PYTHONUNBUFFERED=1 \
    UV_NO_SYNC=1

# Run as a non-root user for defense in depth.
RUN useradd --create-home --uid 1000 agent \
    && chown -R agent:agent /app
USER agent

EXPOSE 7777

# AgentOS's root returns 200 even in degraded mode (no Apps::AiAssistent).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -fsS http://localhost:7777/ || exit 1

CMD ["uv", "run", "main.py"]
