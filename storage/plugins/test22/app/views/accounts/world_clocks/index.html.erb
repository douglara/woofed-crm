<div class="p-6">
  <h1 class="text-2xl font-bold mb-6"><%= t('plugins.test22.title') %></h1>
  <div class="space-y-4">
    <% @time_zones.each do |tz| %>
      <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
        <div class="flex justify-between items-center">
          <span class="font-medium text-gray-700"><%= t("plugins.test22.#{tz[:key]}") %></span>
          <span 
            class="text-2xl font-mono font-bold text-blue-600"
            data-controller="world-clock"
            data-world-clock-zone-value="<%= tz[:zone] %>"
          >
            <%= Time.use_zone(tz[:zone]) { Time.zone.now.strftime("%H:%M:%S") } %>
          </span>
        </div>
        <div class="text-sm text-gray-500 mt-1">
          UTC <%= tz[:offset] %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-world-clock-zone]').forEach(function(el) {
      var zone = el.dataset.worldClockZone;
      setInterval(function() {
        var now = new Date();
        var options = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: zone };
        el.textContent = now.toLocaleTimeString('en-US', options);
      }, 1000);
    });
  });
</script>
