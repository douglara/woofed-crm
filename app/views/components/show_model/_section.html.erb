<% section_id = "#{title.parameterize}-#{model.class.name.parameterize}-#{model.object_id}" %>
<div class="mb-5 color-bg-surface-default border color-border-default rounded " aria-expanded="false" data-accordion="open" id="<%= "#{title.parameterize}-#{model.class.name.parameterize}" %>-section" data-controller="load-lucid-icons load-flowbite">
  <header class="flex flex-wrap items-center justify-between gap-2 p-4">
    <div class="flex items-center gap-2">
      <i data-lucide="<%= icon %>" class="color-fg-default stroke-1.04 w-5 h-5"></i>
      <h1 class="color-fg-default typography-sub-title-900 ">
        <%= title %>
      </h1>
    </div>
    <div class="flex items-center gap-2">
      <% if local_assigns[:add_path] %>
        <%= link_to add_path, class: "button-default-blank-secondary-icon-only-sm", data: { turbo_frame: :modal } do %>
          <i data-lucide="plus" class="shrink-0" height="16"></i>
        <% end %>
      <% end %>
      <% if local_assigns[:edit_path] %>
        <%= link_to edit_path, class: "button-default-blank-secondary-icon-only-sm" do %>
          <i data-lucide="pencil" class="shrink-0" height="16"></i>
        <% end %>
      <% end %>
      <button type="button" class="button-default-blank-secondary-icon-only-sm" data-accordion-target="#accordion-collapse-<%= section_id %>" aria-expanded="true" aria-controls="accordion-collapse-<%= section_id %>">
        <i data-accordion-icon data-lucide="chevron-down" class="rotate-180 shrink-0" height="16"></i>
      </button>
    </div>
  </header>
  <div class="p-4 border-t color-border-default" id="accordion-collapse-<%= section_id %>" aria-labelledby="accordion-collapse-heading-<%= section_id %>">
    <%= yield %>
  </div>
</div>
