<div class='max-w-md self-center'>
  <h1 class="text-[2rem] text-dark-palette-p4 mb-0.5">
    <%= t('views.devise.passwords.new.title') %>
  </h1>
  <p class='text-dark-palette-p4 typography-body-r-lh150 mb-8'>
    <%= t('views.devise.passwords.new.subtitle') %>
  </p>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, data: { turbo: false }) do |f| %>
    <% if flash[:alert] %>
      <p class="typography-sub-title-900 color-fg-feedback-danger mb-5"><%= flash[:alert] %></p>
    <% end %>
    <div class="grid gap-5 mb-2">
      <div class="grid gap-2">
        <%= f.label :email, class: "typography-text-m-lh150 leading-none text-dark-gray-palette-p1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input h-9" %>
      </div>
      <%= submit_button(f, t('views.devise.passwords.new.send_instructions'), class: 'grid justify-items-center', size: :md) %>
    </div>
  <% end %>
  <div class="text-center typography-text-m-lh150 text-dark-gray-palette-p1 mt-5">
    <%= link_to t('views.devise.passwords.new.back_to_login'), new_session_path(resource_name), data: { turbo: false }, class: "text-brand-palette-02 hover:text-brand-palette-01" %>
  </div>
</div>
