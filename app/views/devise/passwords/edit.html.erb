<div class='max-w-md self-center'>
  <h1 class="text-[2rem] text-dark-palette-p4 mb-0.5">
    <%= t('views.devise.passwords.edit.title') %>
  </h1>
  <% if @minimum_password_length %>
    <p class='text-dark-palette-p4 typography-body-r-lh150 mb-8'>
      <%= t('views.devise.passwords.edit.subtitle', min: @minimum_password_length) %>
    </p>
  <% end %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, data: { turbo: false }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <div class="grid gap-5 mb-2">
      <div class="grid gap-2">
        <%= f.label :password, t('views.devise.passwords.edit.new_password'), class: "typography-text-m-lh150 leading-none text-dark-gray-palette-p1" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-input w-full h-9" %>
      </div>
      <div class="grid gap-2 mb-4">
        <%= f.label :password_confirmation, t('views.devise.passwords.edit.confirm_password'), class: "typography-text-m-lh150 leading-none text-dark-gray-palette-p1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input w-full h-9" %>
      </div>
      <%= submit_button(f, t('views.devise.passwords.edit.save_password'), class: 'grid justify-items-center', size: :md) %>
    </div>
  <% end %>
  <div class="text-center typography-text-m-lh150 text-dark-gray-palette-p1 mt-5">
    <%= link_to t('views.devise.passwords.edit.back_to_login'), new_session_path(resource_name), data: { turbo: false }, class: "text-brand-palette-02 hover:text-brand-palette-01" %>
  </div>
</div>
