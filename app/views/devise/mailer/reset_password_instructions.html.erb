<% content_for :title, t('devise.mailer.reset_password_instructions.subject') %>

<% content_for :banner do %>
  <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background-color:#5B63D3;border-radius:12px 12px 0 0;overflow:hidden;">
    <tbody><tr>
      <td style="padding:10px 32px;">
        <p style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;font-weight:500;line-height:13px;color:#ffffff;">
          <%= t('devise.mailer.reset_password_instructions.banner') %>
        </p>
      </td>
    </tr></tbody>
  </table>
<% end %>

<h1 style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:24px;font-weight:600;line-height:1.3;color:#16181F;margin:0 0 24px;">
  <%= t('devise.mailer.reset_password_instructions.title') %>
</h1>

<p style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:14px;font-weight:400;line-height:22px;color:#232838;margin:0 0 16px;">
  <%= t('devise.mailer.reset_password_instructions.greeting', recipient: @resource.email) %>
</p>

<p style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:14px;font-weight:400;line-height:22px;color:#232838;margin:0 0 16px;">
  <%= t('devise.mailer.reset_password_instructions.instruction') %>
</p>

<p style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:14px;font-weight:400;line-height:22px;color:#232838;margin:0 0 24px;">
  <strong><%= t('devise.mailer.reset_password_instructions.expiry') %></strong>
</p>

<!--[if mso]>
<v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word"
  href="<%= edit_password_url(@resource, reset_password_token: @token) %>"
  style="height:35px;v-text-anchor:middle;width:200px;" arcsize="23%"
  strokecolor="#7C87F7" fillcolor="#5B63D3">
  <w:anchorlock/>
  <center style="color:#ffffff;font-family:sans-serif;font-size:13px;font-weight:bold;">
    <%= t('devise.mailer.reset_password_instructions.action') %>
  </center>
</v:roundrect><br><br>
<![endif]-->
<!--[if !mso]><!-->
<a href="<%= edit_password_url(@resource, reset_password_token: @token) %>"
   style="display:inline-block;background-color:#5B63D3;color:#ffffff;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;font-weight:500;line-height:1;text-decoration:none;padding:10px 16px;border-radius:8px;border:1px solid #7C87F7;box-shadow:0px 1px 4px 0px rgba(0,0,0,0.25);mso-hide:all;">
  <%= t('devise.mailer.reset_password_instructions.action') %>
</a>
<!--<![endif]-->

<p style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;font-weight:400;line-height:20px;color:#646E87;margin:24px 0 0;">
  <%= t('devise.mailer.reset_password_instructions.instruction_2') %>
  <%= t('devise.mailer.reset_password_instructions.instruction_3') %>
</p>
