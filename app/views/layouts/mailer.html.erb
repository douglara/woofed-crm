<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? yield(:title) : 'WoofedCRM' %></title>
  <!--[if !mso]><!-->
  <style type="text/css">
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');
  </style>
  <!--<![endif]-->
  <style type="text/css">
    #outlook a { padding: 0; }
    body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
    p { display: block; margin: 0; }
    a { color: #5B63D3; text-decoration: none; }
    strong { font-weight: 600; }
  </style>
  <meta content="light only" name="color-scheme">
</head>
<body style="margin:0;padding:0;background-color:#F8F9FC;word-spacing:normal;">
<div style="background-color:#F8F9FC;" role="article" lang="en">

  <!-- Logo -->
  <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;max-width:600px;margin:0 auto;">
    <tbody><tr>
      <td style="padding:48px 20px 32px;text-align:center;">
        <a href="<%= ENV.fetch('FRONTEND_URL', 'https://woofedcrm.com') %>" target="_blank">
          <%= image_tag attachments['logo.png'].url,
                        alt: 'WoofedCRM',
                        width: 140,
                        style: 'border:0;display:block;outline:none;text-decoration:none;margin:0 auto;' %>
        </a>
      </td>
    </tr></tbody>
  </table>

  <!-- Card -->
  <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;max-width:600px;margin:0 auto 0;background-color:#ffffff;border-radius:12px;border:1px solid #E2E4E9;overflow:hidden;box-shadow:0px 4px 7px 0px rgba(0,0,0,0.03);" bgcolor="#FFFFFF">
    <tbody><tr>
      <td style="border-radius:12px;">

        <!-- Banner slot (optional per-email colored header) -->
        <% if content_for?(:banner) %>
          <%= yield :banner %>
        <% end %>

        <!-- Main content -->
        <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
          <tbody><tr>
            <td style="padding:32px;">
              <%= yield %>
            </td>
          </tr></tbody>
        </table>

        <!-- Card footer -->
        <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
          <tbody><tr>
            <td style="background-color:#F4F5F8;border-top:1px solid #DFE3EA;border-radius:0 0 12px 12px;padding:16px 32px;">
              <p style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;font-weight:400;line-height:21px;color:#646E87;">
                <%= t('mailer.layout.footer_contact') %> <a href="mailto:hi@woofedcrm.com" style="color:#5B63D3;">hi@woofedcrm.com</a>
              </p>
            </td>
          </tr></tbody>
        </table>

      </td>
    </tr></tbody>
  </table>

  <!-- Bottom footer -->
  <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;max-width:600px;margin:0 auto;">
    <tbody><tr>
      <td style="padding:32px 20px 48px;text-align:center;">
        <p style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:12px;font-weight:400;line-height:20px;color:#70778C;">
          WoofedCRM &middot; <a href="<%= ENV.fetch('FRONTEND_URL', 'https://woofedcrm.com') %>" style="color:#70778C;">woofedcrm.com</a>
        </p>
      </td>
    </tr></tbody>
  </table>

</div>
</body>
</html>
