<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
    <title>Woofed CRM</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%= vite_stylesheet_tag 'application', 'data-turbolinks-track': 'reload', media: 'all' %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%= render "layouts/shared/analytics_scripts" %>
    <%= tag.meta name: "user-data", content: {
      id: current_user&.id,
      full_name: current_user&.full_name,
      email: current_user&.email,
      account_id: current_user&.account&.id,
      account_name: current_user&.account&.name,
      theme_preference: current_user&.theme_preference
    }.to_json %>
    <%= yield :stylesheets %>
  </head>
  <body class="bg-brand-palette-08" data-controller="theme-preference">
    <%= render partial: 'components/flash_message', locals: { message: flash[:notice] } %>
    <%= content_for?(:content) ? yield(:content) : yield %>
    <%= yield :javascripts %>
  </body>
</html>
