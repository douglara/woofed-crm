<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Woofed CRM - Acesso</title>
    <meta name="description" content="Faça login no Woofed CRM para gerenciar seus leads e vendas">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_pack_tag 'application', defer: true %>
    <style>
      /* CSS Custom Properties */
      :root {
        /* Colors */
        --primary-50: #F6F8FE;
        --primary-100: #EDF1FD;
        --primary-200: #D9DEFF;
        --primary-300: #B8C0F4;
        --primary-400: #8686E8;
        --primary-500: #6857D9;
        --primary-600: #31388D;
        --primary-700: #1B2C58;
        --primary-800: #121D3A;
        
        --gray-50: #FAF9FD;
        --gray-100: #F2F1F7;
        --gray-200: #E7E6EF;
        --gray-300: #CBC8DB;
        --gray-400: #B1AEC2;
        --gray-500: #888599;
        --gray-600: #605E70;
        --gray-700: #3A3847;
        --gray-800: #282733;
        --gray-900: #17161E;
        
        --success-50: #D8F2E1;
        --success-100: #AAF5AF;
        --success-500: #127047;
        
        --error-50: #FAEEEB;
        --error-100: #F0A87B;
        --error-500: #B2351C;
        
        --white: #FFFFFF;
        --white-alpha-95: rgba(255, 255, 255, 0.95);
        --white-alpha-80: rgba(255, 255, 255, 0.8);
        
        /* Spacing Scale */
        --space-xs: 0.25rem;   /* 4px */
        --space-sm: 0.5rem;    /* 8px */
        --space-md: 0.75rem;   /* 12px */
        --space-lg: 1rem;      /* 16px */
        --space-xl: 1.5rem;    /* 24px */
        --space-2xl: 2rem;     /* 32px */
        --space-3xl: 2.5rem;   /* 40px */
        --space-4xl: 3rem;     /* 48px */
        
        /* Border Radius */
        --radius-sm: 0.5rem;   /* 8px */
        --radius-md: 0.75rem;  /* 12px */
        --radius-lg: 1rem;     /* 16px */
        --radius-xl: 1.25rem;  /* 20px */
        
        /* Shadows */
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        --shadow-primary: 0 4px 16px rgba(104, 87, 217, 0.2);
        --shadow-primary-hover: 0 6px 20px rgba(104, 87, 217, 0.3);
        
        /* Typography */
        --font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
        --font-size-sm: 0.875rem;   /* 14px */
        --font-size-base: 0.9375rem; /* 15px */
        --font-size-lg: 1.125rem;    /* 18px */
        --font-size-xl: 1.75rem;     /* 28px */
        --font-weight-medium: 500;
        --font-weight-semibold: 600;
        --font-weight-bold: 700;
        --line-height-tight: 1.25;
        --line-height-base: 1.5;
        
        /* Transitions */
        --transition-fast: 0.15s ease;
        --transition-base: 0.2s ease;
        --transition-slow: 0.3s ease;
        
        /* Z-index */
        --z-background: 0;
        --z-content: 10;
        --z-modal: 50;
      }
      
      /* Reset and Base Styles */
      *, *::before, *::after {
        box-sizing: border-box;
      }
      
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        min-height: 100dvh; /* Dynamic viewport height */
        background: linear-gradient(135deg, var(--primary-50) 0%, var(--primary-100) 60%, var(--primary-200) 100%);
        font-family: var(--font-family);
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--gray-700);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-lg);
        position: relative;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      /* Background Pattern */
      body::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: 
          radial-gradient(circle at 25% 25%, rgba(104, 87, 217, 0.04) 0%, transparent 50%),
          radial-gradient(circle at 75% 75%, rgba(134, 134, 232, 0.04) 0%, transparent 50%);
        z-index: var(--z-background);
        pointer-events: none;
      }
      
      /* Main Container */
      .auth-container {
        background: var(--white-alpha-95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: var(--radius-xl);
        border: 1px solid rgba(242, 241, 247, 0.8);
        box-shadow: 
          var(--shadow-lg),
          0 8px 32px rgba(104, 87, 217, 0.08),
          inset 0 1px 0 var(--white-alpha-80);
        width: 100%;
        padding-inline: 2rem;
        max-width: min(600px, calc(100vw - 2rem));
        position: relative;
        z-index: var(--z-content);
        overflow: hidden;
      }
      
      /* Header Accent */
      .auth-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--primary-500), var(--primary-400), var(--primary-500));
        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      }
      
      /* Content Container */
      .auth-content {
        padding: var(--space-4xl) var(--space-xl) var(--space-3xl);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-xl);
      }
      
      /* Logo */
      .auth-logo {
        width: clamp(180px, 50vw, 240px);
        height: auto;
        filter: drop-shadow(0 2px 8px rgba(104, 87, 217, 0.1));
        transition: transform var(--transition-slow);
      }
      
      .auth-logo:hover {
        transform: scale(1.02);
      }
      
      /* Title */
      .auth-title {
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        text-align: center;
        margin: 0;
        background: linear-gradient(135deg, var(--gray-700), var(--gray-600));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      
      /* Subtitle */
      .auth-subtitle {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-medium);
        color: var(--gray-500);
        text-align: center;
        margin: calc(var(--space-sm) * -1) 0 0 0;
      }
      
      /* Alert Messages */
      .auth-notice,
      .auth-alert {
        width: 100%;
        padding: var(--space-lg);
        border-radius: var(--radius-md);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-medium);
        text-align: center;
        border: 1px solid;
        margin: 0;
      }
      
      .auth-notice {
        color: var(--success-500);
        background: linear-gradient(135deg, var(--success-50), var(--success-100));
        border-color: var(--success-100);
        box-shadow: 0 2px 8px rgba(18, 112, 71, 0.1);
      }
      
      .auth-alert {
        color: var(--error-500);
        background: linear-gradient(135deg, var(--error-50), var(--error-100));
        border-color: var(--error-100);
        box-shadow: 0 2px 8px rgba(178, 53, 28, 0.1);
      }
      
      /* Form Styles */
      .form-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-xl);
      }
      
      .form-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }
      
      .form-label {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        color: var(--gray-700);
        margin: 0;
      }
      
      .form-input {
        width: 100%;
        padding: var(--space-lg) var(--space-xl);
        border: 2px solid var(--gray-100);
        border-radius: var(--radius-md);
        background: var(--gray-50);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-medium);
        color: var(--gray-700);
        transition: all var(--transition-base);
        outline: none;
        font-family: inherit;
      }
      
      .form-input::placeholder {
        color: var(--gray-400);
        font-weight: var(--font-weight-medium);
      }
      
      .form-input:focus {
        border-color: var(--primary-500);
        background: var(--white);
        box-shadow: 0 0 0 3px rgba(104, 87, 217, 0.1);
        transform: translateY(-1px);
      }
      
      .form-input:hover:not(:focus) {
        border-color: var(--gray-200);
        background: var(--white);
      }
      
      /* Error State */
      .form-input.error {
        border-color: var(--error-500);
        background: var(--error-50);
        box-shadow: 0 0 0 3px rgba(178, 53, 28, 0.1);
      }
      
      .form-input.error:focus {
        border-color: var(--error-500);
        box-shadow: 0 0 0 3px rgba(178, 53, 28, 0.2);
      }
      
      /* Remember Me */
      .remember-me {
        display: flex;
        align-items: center;
        gap: var(--space-md);
        margin: calc(var(--space-sm) * -1) 0 0 0;
      }
      
      .remember-me-checkbox {
        width: 18px;
        height: 18px;
        border: 2px solid var(--primary-200);
        border-radius: var(--space-xs);
        accent-color: var(--primary-500);
        cursor: pointer;
        transition: all var(--transition-fast);
      }
      
      .remember-me-checkbox:focus {
        outline: 2px solid var(--primary-500);
        outline-offset: 2px;
      }
      
      .remember-me-label {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-medium);
        color: var(--gray-600);
        cursor: pointer;
        user-select: none;
      }
      
      /* Primary Button */
      .btn-primary {
        width: 100%;
        padding: var(--space-lg) var(--space-xl);
        background: linear-gradient(135deg, var(--primary-500), var(--primary-400));
        color: var(--white);
        border: none;
        border-radius: var(--radius-md);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        font-family: inherit;
        cursor: pointer;
        transition: all var(--transition-base);
        box-shadow: var(--shadow-primary);
        position: relative;
        overflow: hidden;
        text-transform: none;
        letter-spacing: 0;
      }
      
      .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: var(--shadow-primary-hover);
        background: linear-gradient(135deg, var(--primary-600), var(--primary-500));
      }
      
      .btn-primary:active:not(:disabled) {
        transform: translateY(0);
        transition: transform var(--transition-fast);
      }
      
      .btn-primary:focus {
        outline: 2px solid var(--primary-500);
        outline-offset: 2px;
      }
      
      .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
        box-shadow: var(--shadow-sm);
      }
      
      /* Loading State */
      .btn-primary.loading::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 16px;
        height: 16px;
        margin: -8px 0 0 -8px;
        border: 2px solid transparent;
        border-top: 2px solid var(--white);
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }
      
      .btn-primary.loading {
        color: transparent;
      }
      
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
      
      /* Links */
      .auth-links {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-md);
        margin: 0;
      }
      
      .auth-link {
        color: var(--primary-500);
        text-decoration: none;
        font-weight: var(--font-weight-medium);
        font-size: var(--font-size-sm);
        transition: color var(--transition-fast);
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--space-xs);
      }
      
      .auth-link:hover {
        color: var(--primary-600);
        text-decoration: underline;
      }
      
      .auth-link:focus {
        outline: 2px solid var(--primary-500);
        outline-offset: 2px;
      }
      
      /* Responsive Design */
      @media (max-width: 480px) {
        body {
          padding: var(--space-sm);
        }
        
        .auth-content {
          padding: var(--space-3xl) var(--space-lg) var(--space-2xl);
          gap: var(--space-lg);
        }
        
        .form-input {
          padding: var(--space-md) var(--space-lg);
        }
        
        .btn-primary {
          padding: var(--space-md) var(--space-lg);
        }
      }
      
      @media (max-width: 320px) {
        .auth-content {
          padding: var(--space-2xl) var(--space-md) var(--space-xl);
        }
      }
      
      /* High Contrast Mode */
      @media (prefers-contrast: high) {
        .auth-container {
          border: 2px solid var(--gray-800);
        }
        
        .form-input {
          border-width: 2px;
        }
        
        .btn-primary {
          background: var(--primary-700);
        }
      }
      
      /* Reduced Motion */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
        
        .auth-logo:hover {
          transform: none;
        }
        
        .btn-primary:hover {
          transform: none;
        }
        
        .form-input:focus {
          transform: none;
        }
      }
      
      /* Dark Mode Support */
      @media (prefers-color-scheme: dark) {
        /* Note: Keeping light theme for now, but variables are ready for dark mode */
      }
      
             /* Screen Reader Only */
       .sr-only {
         position: absolute;
         width: 1px;
         height: 1px;
         padding: 0;
         margin: -1px;
         overflow: hidden;
         clip: rect(0, 0, 0, 0);
         white-space: nowrap;
         border: 0;
       }
       
       /* Print Styles */
       @media print {
         body::before {
           display: none;
         }
         
         .auth-container {
           background: var(--white);
           box-shadow: none;
           border: 1px solid var(--gray-300);
         }
       }
    </style>
  </head>
  <body>
    <div class="auth-container">
      <div class="auth-content">
        <%= image_tag 'logo.svg', alt: 'Woofed CRM Logo', class: 'auth-logo' %>
        <% if notice %>
          <div class="auth-notice" role="alert" aria-live="polite"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="auth-alert" role="alert" aria-live="assertive"><%= alert %></div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
