<%= form_for([current_user.account, contact], html:{class: "flex flex-col gap-5"}) do | form | %>
  <% if contact.errors.any? %>
    <div>
      <ul>
        <% contact.errors.each do |error| %>
          <li class="typography-body-s-lh150 text-auxiliary-palette-red"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= render 'components/show_model/form_fields', model: contact, form: form %>
  <div class="flex gap-2 self-end">
    <%= link_to account_custom_attributes_definitions_path(current_user.account), class:"button-default-fill-secondary-sm", data:{ turbo_frame: :_top } do %>
      <i data-lucide="plus"></i>
      <%= t('activerecord.models.custom_attribute_definition.add') %>
    <% end %>
    <%= submit_button(form) %>
  </div>
<% end %>
