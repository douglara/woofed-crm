<%= turbo_frame_tag dom_id(@contact, :deal_show_page_overview) do %>
  <%= render "/accounts/deals/details/edit",
  model: @contact,
  update_path: account_contact_path(current_user.account, @contact)
   %>
<% end %>
<% content_for :sidebar do %>
  <%= render 'components/show_model/sidebar', model: @contact,
      links: [
        { label: t('activerecord.models.show'), icon: "info" }
      ] %>
<% end %>
<%= render 'components/overlays/drawer_show_model', model: @contact, title: t('activerecord.models.contact.edit') do %>
  <%= turbo_frame_tag dom_id(@contact, :details_section) do %>
    <%= render 'components/show_model/section', model: @contact, title: t('activerecord.models.show'), icon: 'info' do %>
      <%= render 'details_form', contact: @contact %>
    <% end %>
  <% end %>
<% end %>
