<% content_for :sidebar do %>
  <%= render 'components/show_model/sidebar', model: @product,
      links: [
        { label: t('activerecord.models.show'), icon: "info" },
        { label: t('activerecord.models.attachment.other'), icon: "paperclip" }
      ] %>
<% end %>
<%= render 'components/overlays/drawer_show_model', model: @product, title: t('activerecord.models.product.edit') do %>
  <%= turbo_frame_tag dom_id(@product, :details_section) do %>
    <%= render 'components/show_model/section', model: @product, title: t('activerecord.models.show'), icon: 'info' do %>
      <%= render 'details_form', product: @product %>
    <% end %>
  <% end %>
  <%= render 'accounts/products/attachments_section', product: @product %>
<% end %>
