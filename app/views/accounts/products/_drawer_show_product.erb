<% content_for :sidebar do %>
  <%= render 'components/show_model/sidebar', model: product,
      links: [
        { label: t('activerecord.models.show'), icon: "info" },
        { label: t('activerecord.models.attachment.other'), icon: "paperclip" },
        { label: t('activerecord.models.deal.other'), icon: "clipboard-list" }
      ] %>
<% end %>
<% content_for :show_additional_content do %>
  <%= render 'components/show_model/section', model: product, title: t('activerecord.models.attachment.other'), icon: 'paperclip' do %>
    <div class="flex flex-col gap-5">
      <% if product.image_attachments.present? %>
        <h2 class="typography-body-s-lh150 text-dark-gray-palette-p1">
          <%= t('views.accounts.products.form.images_attached') %>
        </h2>
        <div class='flex items-end gap-4 flex-wrap'>
          <% product.image_attachments.each do |attachment| %>
            <div class='grid border-2 rounded-md w-[250px] relative'>
              <div class='w-full h-[150px]' data-controller='lightbox'>
                <%= image_tag attachment.file, class: 'cursor-pointer object-cover w-full h-full rounded-t-md', data: { src: rails_blob_url(attachment.file), sub_html: attachment.file.filename.to_s } %>
              </div>
              <div class='bg-brand-palette-08 p-1.5 grid gap-0.5 rounded-b-md'>
                <p class='typography-sub-text-s-lh150 text-dark-gray-palette-p1 truncate max-w-[180px]'><%= attachment.file.filename.to_s %></p>
                <div class='flex justify-between items-center'>
                  <p class='typography-micro-m-lh150 text-dark-gray-palette-p4'><%= number_to_human_size(attachment.file.byte_size) %></p>
                  <%= link_to rails_blob_path(attachment.file), class: 'flex items-center h-7 w-7 p-1 text-dark-gray-palette-p3 border-[1.5px] border-[#e5e7eb00] hover:border-brand-palette-06 hover:border-[1.5px] hover:bg-brand-palette-08 hover:rounded-md hover:text-brand-palette-03 transtion ease-in-out delay-250' do %>
                    <i data-lucide="download" height="15"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if product.video_attachments.present? %>
        <h2 class="typography-body-s-lh150 text-dark-gray-palette-p1">
          <%= t('views.accounts.products.form.videos_attached') %>
        </h2>
        <div class='flex items-end gap-4 flex-wrap'>
          <% product.video_attachments.each do |attachment| %>
            <div class='grid border-2 rounded-md w-[250px] relative'>
              <div class='w-full max-h-[250px]'>
                <%= video_tag rails_blob_url(attachment.file), size:'250x250', controls: true, class: 'rounded-t-md object-scale-down w-full max-h-[250px]' %>
              </div>
              <div class='bg-brand-palette-08 p-1.5 grid gap-0.5 rounded-b-md'>
                <p class='typography-sub-text-s-lh150 text-dark-gray-palette-p1 truncate max-w-[180px]'><%= attachment.file.filename.to_s %></p>
                <div class='flex justify-between items-center'>
                  <p class='typography-micro-m-lh150 text-dark-gray-palette-p4'><%= number_to_human_size(attachment.file.byte_size) %></p>
                  <%= link_to rails_blob_path(attachment.file), class: 'flex items-center h-7 w-7 p-1 text-dark-gray-palette-p3 border-[1.5px] border-[#e5e7eb00] hover:border-brand-palette-06 hover:border-[1.5px] hover:bg-brand-palette-08 hover:rounded-md hover:text-brand-palette-03 transtion ease-in-out delay-250' do %>
                    <i data-lucide="download" height="15"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if product.file_attachments.present? %>
        <h2 class="typography-body-s-lh150 text-dark-gray-palette-p1">
          <%= t('views.accounts.products.form.files_attached') %>
        </h2>
        <div class='flex items-end gap-4 flex-wrap'>
          <% product.file_attachments.each do |attachment| %>
            <div class='grid border-2 rounded-md w-[200px]'>
              <div class='flex items-center h-[100px] relative'>
                <i data-lucide="file" style="width: 50px; height: 50px" class="stroke-dark-gray-palette-p3 m-auto"></i>
              </div>
              <div class='bg-brand-palette-08 p-1.5 grid gap-0.5 rounded-b-md'>
                <p class='typography-sub-text-s-lh150 text-dark-gray-palette-p1 truncate max-w-[180px]'><%= attachment.file.filename.to_s %></p>
                <div class='flex justify-between items-center'>
                  <p class='typography-micro-m-lh150 text-dark-gray-palette-p4'><%= number_to_human_size(attachment.file.byte_size) %></p>
                  <%= link_to rails_blob_path(attachment.file), class: 'flex items-center h-7 w-7 p-1 text-dark-gray-palette-p3 border-[1.5px] border-[#e5e7eb00] hover:border-brand-palette-06 hover:border-[1.5px] hover:bg-brand-palette-08 hover:rounded-md hover:text-brand-palette-03 transtion ease-in-out delay-250' do %>
                    <i data-lucide="download" height="15"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= render 'components/show_model/section', model: product, title: t('activerecord.models.deal.other'), icon: 'clipboard-list' do %>
    <ul class="flex flex-col gap-2">
      <% product.deal_products.each do |deal_product| %>
        <%= content_tag :li, id: dom_id(deal_product.deal), class: "grid gap-5 border-b-2 border-light-palette-p3 last:border-none py-5 first:pt-0 last:pb-0", data: {controller: 'load-lucid-icons'} do %>
          <div class= "flex items-center gap-4">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg border-2 border-light-palette-p3 typography-text-m-lh150 text-dark-gray-palette-p3 ">
              <i data-lucide="clipboard-list" class='w-5 h-5'></i>
            </div>
            <div class="mr-auto">
              <div class="flex flex-col">
                <h2 class="typography-text-s-lh150 text-dark-gray-palette-p1">
                  <%= deal_product.deal.name %>
                </h2>
                <div class="flex items-center gap-1.5 typography-sub-text-r-lh150 text-dark-gray-palette-p4">
                  <span>
                    <%= "#{t('activerecord.attributes.deal_product.quantity')}: #{deal_product.quantity}" %>
                  </span>
                  <span>|</span>
                  <%= render 'components/formatters/currency', value: deal_product.total_amount_in_cents %>
                </div>
              </div>
            </div>
            <%= link_to account_deal_path(Current.account, deal_product.deal.id ), data: {turbo_frame: :_top} , class: 'flex items-center justify-center rounded text-gray-pallete-p3 w-8 h-8 hover:bg-light-palette-p4 hover:text-dark-gray-palette-p1' do %>
              <i data-lucide="arrow-right"></i>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  <% end %>
<% end %>
<%= render 'components/show_model/show_model', model: product, edit_path: edit_account_product_path(Current.account, product) %>
