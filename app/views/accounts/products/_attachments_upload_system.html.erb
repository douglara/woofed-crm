<div class="mt-4 flex flex-col gap-2.5 border color-border-default p-4" >
  <div class='flex gap-2.5 items-center'>
    <div class='w-full h-9 flex items-center justify-center color-bg-fill-default color-border-default hover:color-bg-fill-hard hover:color-border-harder cursor-pointer' data-action="click->product-form--upload-files#trigger">
      <div class='flex items-center gap-2 items-center'>
        <i data-lucide="upload-cloud" class="h-5 w-5 color-fg-soft"></i>
        <span class="typography-body-900 color-fg-soft"><%= t('activerecord.models.upload_file') %></span>
      </div>
    </div>
  </div>
  <div id='uploads' class="max-h-56 grid gap-4 overflow-y-auto custom-scroll-list-deal">
    <div class='h-11 px-2 color-bg-fill-soft border color-border-default rounded flex items-center gap-2.5 relative overflow-hidden hidden' id='fileWrapper' >
      <div class="color-bg-fill-default h-full left-0 ease-in transition-all duration-300 absolute" id="progressBar" style="width: 0%; z-index: 1"></div>
      <div id='fileInfoWrapper' style="z-index: 10">
        <a href="" class='flex gap-2 items-center pointer-events-none' id='linkThumb'>
          <img src="" class='w-8 h-8 rounded-lg object-cover hidden' id='fileThumb'>
          <i data-lucide="video" class='w-8 h-8 stroke-1.25 color-fg-default hidden'></i>
          <i data-lucide="file" class='w-8 h-8 stroke-1.25 color-fg-default hidden'></i>
          <p class='color-fg-default typography-body-800 w-56 truncate' id='fileName'></p>
        </a>
      </div>
      <div class='flex-1 w-full' id='uploadInfo'>
      </div>
      <div class="cursor-pointer p-1" data-action="click->product-form--upload-files#removeFile"  style="z-index: 10">
        <i data-lucide="x" class="w-4 h-4 color-fg-default stroke-1.25"></i>
      </div>
    </div>
    <input type="file" class="hidden" multiple data-product-form--upload-files-target="fileInput" data-action="change->product-form--upload-files#acceptFiles"/>
  </div>
  <%= submit_button form, t('activerecord.models.add'), size: :sm, color: :secondary, class: 'self-end', data: { action: 'product-form--upload-files#submitForm' } %>
</div>
