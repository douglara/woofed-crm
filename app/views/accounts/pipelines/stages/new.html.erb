<section class="px-4 py-5 bg-light-palette-p5 border-2 border-light-palette-p3 rounded-md m-8">
  <%= form_with(model: [Current.account, @pipeline, @stage], url: account_pipeline_stages_path(Current.account, @pipeline), class: "flex flex-col gap-5") do |form| %>
    <% if @stage.errors.any? %>
      <div>
        <ul>
          <% @stage.errors.each do |error| %>
            <li class="typography-body-s-lh150 text-auxiliary-palette-red"><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <h2 class="typography-body-s-lh150 text-dark-gray-palette-p1">
      <%= t('activerecord.models.stage.new') %>
    </h2>
    <div class="grid gap-4">
      <div class="flex flex-col gap-1">
        <%= form.label :name, class: "typography-text-m-lh150 text-dark-gray-palette-p1" %>
        <%= form.text_field :name, class: "form-input" %>
      </div>
      <div class="flex flex-col gap-1">
        <%= form.label :background_color, class: "typography-text-m-lh150 text-dark-gray-palette-p1" %>
        <div class="flex gap-2 items-center">
          <%= form.color_field :background_color, class: "h-10 w-16 rounded border border-light-palette-p3 cursor-pointer", value: @stage.background_color.presence || '#FFFFFF' %>
          <%= form.text_field :background_color, class: "form-input flex-1", placeholder: "#FFFFFF" %>
        </div>
      </div>
      <div class="flex flex-col gap-1">
        <%= form.label :text_color, class: "typography-text-m-lh150 text-dark-gray-palette-p1" %>
        <div class="flex gap-2 items-center">
          <%= form.color_field :text_color, class: "h-10 w-16 rounded border border-light-palette-p3 cursor-pointer", value: @stage.text_color.presence || '#000000' %>
          <%= form.text_field :text_color, class: "form-input flex-1", placeholder: "#000000" %>
        </div>
      </div>
    </div>
    <div class="flex gap-2 self-end mt-5">
      <%= link_to account_pipeline_path(Current.account, @pipeline), class: "btn-secondary" do %>
        <%= t('cancel') %>
      <% end %>
      <%= form.submit class: 'btn-primary self-end cursor-pointer' %>
    </div>
  <% end %>
</section>
