<% content_for :sidebar do %>
  <%= render 'components/show_model/sidebar', model: @company,
      links: [
        { label: t('activerecord.models.show'), icon: "info" },
        { label: t('activerecord.models.attachment.other'), icon: "paperclip" }
      ] %>
<% end %>
<%= render 'components/overlays/drawer_show_model', model: @company, title: t('activerecord.models.company.edit') do %>
  <%= turbo_frame_tag dom_id(@company, :details_section) do %>
    <%= render 'components/show_model/section', model: @company, title: t('activerecord.models.show'), icon: 'info' do %>
      <%= render 'details_form', company: @company %>
    <% end %>
  <% end %>
  <%= render 'components/show_model/attachments_section', model: @company %>
<% end %>
