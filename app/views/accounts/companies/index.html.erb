<div class="bg-light-palette-p5 border-2 border-neutral-150 border-light-palette-p3 rounded m-8">
  <header class="border-b-2 border-neutral-100 flex items-center justify-end gap-2 p-4 sticky top-0 bg-light-palette-p5 z-20">
    <%= render '/components/form/input_expandable_search',
               search_url: account_companies_path(Current.account),
               turbo_frame_search: :companies_table,
               placeholder: t('activerecord.models.search', model: @companies.model_name.human) %>
    <%= link_to new_account_company_path(Current.account), class: 'button-default-blank-secondary-icon-only-sm', data: { turbo_frame: :drawer } do %>
      <i data-lucide="plus" class='h-4 w-4'></i>
    <% end %>
  </header>
  <%= turbo_frame_tag :companies_table do %>
    <div class="overflow-x-auto">
      <table class="w-full text-left rtl:text-right min-w-[1950px]">
        <thead class="border-b border-light-palette-p3">
          <tr>
            <th scope="col" class="py-3 pl-4 pr-4 w-[52px]"></th>
            <th scope="col" class="pr-4 py-3 typography-body-s-lh150 text-dark-gray-palette-p1 max-w-[250px]">
              <%= t('activerecord.attributes.company.name') %>
            </th>
            <th scope="col" class="pr-4 py-3 typography-body-s-lh150 text-dark-gray-palette-p1 max-w-[150px]">
              <%= t('activerecord.attributes.company.phone') %>
            </th>
            <th scope="col" class="pr-4 py-3 typography-body-s-lh150 text-dark-gray-palette-p1 max-w-[250px]">
              <%= t('activerecord.attributes.company.email') %>
            </th>
            <th scope="col" class="pr-4 py-3 typography-body-s-lh150 text-dark-gray-palette-p1 max-w-[150px]">
              <%= t('activerecord.attributes.company.id') %>
            </th>
            <th scope="col" class="pr-4 py-3 typography-body-s-lh150 text-dark-gray-palette-p1 max-w-[130px]">
              <%= t('activerecord.attributes.company.created_at') %>
            </th>
            <th scope="col" class="pr-4 py-3 typography-body-s-lh150 text-dark-gray-palette-p1 max-w-[130px]">
              <%= t('activerecord.attributes.company.updated_at') %>
            </th>
            <th scope="col" class="py-3 pl-4 pr-4 sticky right-0 bg-light-palette-p5 z-10 w-[50px]"></th>
          </tr>
        </thead>
        <tbody class="w-full" id='companies'>
          <%= render partial: '/accounts/companies/company', collection: @companies, as: :company %>
        </tbody>
      </table>
    </div>
    <div class="sticky bottom-0 bg-light-palette-p5 z-10 py-2 px-4 border-t-2 border-light-palette-p3">
      <div class="flex justify-end">
        <%== pagy_nav(@pagy) %>
      </div>
    </div>
  <% end %>
</div>
