<% from_company = @origin.to_sym == :company %>
<% owner = from_company ? @company_contact.company : @company_contact.contact %>
<%= turbo_stream.replace :flash_message do %>
  <%= render partial: 'components/flash_message', locals: { message: t('flash_messages.added', model: (from_company ? Contact : Company).model_name.human) } %>
<% end %>
<%= turbo_stream.append dom_id(owner, :company_contacts) do %>
  <% if from_company %>
    <%= render partial: 'accounts/companies/company_contact', locals: { company_contact: @company_contact } %>
  <% else %>
    <%= render '/components/companies/card_preview', company: @company_contact.company,
               card_id: dom_id(@company_contact),
               details_url: account_company_path(Current.account, @company_contact.company),
               remove_url: account_company_contact_path(Current.account, @company_contact) %>
  <% end %>
<% end %>
<%# Emptying the frame dismisses the modal the form was submitted from. %>
<%= turbo_stream.replace :modal do %>
  <%= turbo_frame_tag :modal %>
<% end %>
