<tr id="<%= dom_id(event_category, :settings__event_categories__event_category) %>" is='turbo-frame' class="border-b-2 border-light-palette-p3 last:border-none" data-controller='load-lucid-icons load-flowbite'>
  <td class="py-2.5 pl-4 pr-4 flex-shrink-0">
    <div class="w-[52px] h-[52px] flex">
      <div class="border-2 rounded-md h-full w-full flex items-center justify-center" style="background-color: <%= event_category.color %>20; border-color: <%= event_category.color %>;">
        <i class="<%= event_category.icon %>" style="color: <%= event_category.color %>;"></i>
      </div>
    </div>
  </td>
  <td class="pr-4 py-2.5 typography-label-1000 color-fg-default max-w-[243px] truncate">
    <%= event_category.name %>
  </td>
  <td class="pr-4 py-2.5 typography-label-1000 color-fg-default max-w-[243px] truncate">
    <i class="<%= event_category.icon %>"></i>
    <span class="ml-2"><%= event_category.icon %></span>
  </td>
  <td class="pr-4 py-2.5 typography-label-1000 color-fg-default max-w-[243px]">
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded border-2 border-light-palette-p3" style="background-color: <%= event_category.color %>;"></div>
      <span><%= event_category.color %></span>
    </div>
  </td>
  <td class="py-2.5 pl-4 pr-4 sticky right-0 bg-light-palette-p5 z-10">
    <div class="flex justify-end gap-2">
      <button id="dropdownEventCategoryBtn_<%= event_category.id %>" data-dropdown-toggle="dropdownEventCategoryOptions<%= event_category.id %>" data-dropdown-placement="left" class="button-default-blank-secondary-icon-only-sm" type="button">
        <i data-lucide="ellipsis-vertical"></i>
      </button>
    </div>
  </td>
</tr>
<div id="dropdownEventCategoryOptions<%= event_category.id %>" class="z-50 hidden bg-white divide-y divide-gray-200 rounded-lg shadow w-48 absolute dark:bg-gray-700">
  <ul class="py-2 typography-text-m-lh150 text-dark-gray-palette-p3 dark:text-gray-200" aria-labelledby="dropdownDefaultButton">
    <li>
      <%= link_to edit_account_settings_event_category_path(Current.account, event_category), data: { turbo_frame: :drawer }, class: "flex items-center space-x-2 px-4 py-2 hover:bg-gray-200 hover:text-dark-gray-palette-p1 dark:hover:bg-gray-600 dark:hover:text-white" do %>
        <i data-lucide="pencil" class="color-fg-soft"></i>
        <p>
          <%= t('activerecord.models.edit') %>
        </p>
      <% end %>
    </li>
    <li>
      <%= link_to account_settings_event_category_path(Current.account, event_category), method: :delete, data: { confirm: t('views.accounts.users.user.are_you_sure?') }, class: "flex items-center space-x-2 px-4 py-2 hover:bg-gray-200 hover:text-dark-gray-palette-p1 dark:hover:bg-gray-600 dark:hover:text-white" do %>
        <i data-lucide="trash" class="color-fg-soft"></i>
        <p>
          <%= t('activerecord.models.delete') %>
        </p>
      <% end %>
    </li>
  </ul>
</div>
