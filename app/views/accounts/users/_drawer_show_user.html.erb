<% content_for :sidebar do %>
  <%= render 'components/show_model/sidebar', model: user,
      links: [
        { label: t('activerecord.models.show'), icon: "info" },
        { label: t('activerecord.models.deal.other'), icon: "clipboard-list" }
      ] %>
<% end %>
<% content_for :show_additional_content do %>
  <%= render 'components/show_model/section', model: user, title: t('activerecord.models.deal.other'), icon: 'clipboard-list' do %>
    <ul class="flex flex-col gap-2">
      <%= render 'accounts/users/deals_list', deals: deals, pagy: pagy, user: user %>
    </ul>
  <% end %>
<% end %>
<%= render 'components/show_model/show_model', model: user, edit_path: edit_account_user_path(current_user.account, user) %>
