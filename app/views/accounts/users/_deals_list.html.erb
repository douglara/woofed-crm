<%= turbo_frame_tag "user_#{user.id}_deals" do %>
  <%= render 'components/show_model/section', model: user, title: t('activerecord.models.deal.other'), icon: 'clipboard-list' do %>
    <ul class="flex flex-col gap-2">
      <% deals.each do |deal| %>
        <%= render 'accounts/contacts/deal_item', deal: deal %>
      <% end %>
      <% if pagy.pages > 1 %>
        <div class="flex justify-end pt-4 border-t color-border-default mt-4">
          <%== pagy_nav(pagy) %>
        </div>
      <% end %>
    </ul>
  <% end %>
<% end %>
