<%
  stage_hex = (stage.color.presence || '#6857D9')
  _hex = stage_hex.delete('#')
  _r, _g, _b = _hex[0..1].to_i(16), _hex[2..3].to_i(16), _hex[4..5].to_i(16)
  _mix_w = ->(amt) { format('#%02x%02x%02x', _r + ((255 - _r) * amt).round, _g + ((255 - _g) * amt).round, _b + ((255 - _b) * amt).round) }
  _mix_b = ->(amt) { format('#%02x%02x%02x', (_r * (1 - amt)).round, (_g * (1 - amt)).round, (_b * (1 - amt)).round) }
  stage_border = _mix_w.call(0.70)
  stage_grad_from = _mix_w.call(0.35)
  stage_grad_to = stage_hex
  stage_text_dark = _mix_b.call(0.15)
  stage_badge_bg = _mix_w.call(0.88)
%>
<div class="px-4 pb-4 rounded-xl border bg-light-palette-p5 relative" style="border-color: <%= stage_border %>;" data-controller="load-lucid-icons load-flowbite" id="<%= dom_id(stage, filter) %>">
  <div class="absolute top-0 left-0 right-0 h-3 rounded-t-[11px] overflow-hidden pointer-events-none">
    <div class="h-1" style="background: linear-gradient(to right, <%= stage_grad_from %>, <%= stage_grad_to %>);"></div>
  </div>
  <div class="pt-2 pb-3.5 flex flex-col gap-1">
    <div class="flex justify-between items-center gap-1.5">
      <h1 class="typography-text-s-lh150 truncate cursor-default" style="color: <%= stage_text_dark %>;" data-tooltip-target="tooltip-name-<%= stage.id %>" data-tooltip-placement="bottom">
        <%= stage.name %>
      </h1>
      <div id="tooltip-name-<%= stage.id %>" role="tooltip" class="absolute z-10 invisible inline-block px-3 py-2 typography-label-900 font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-xs opacity-0 tooltip">
        <%= stage.name %>
        <div class="tooltip-arrow" data-popper-arrow></div>
      </div>
      <button id="dropdownMenuIconHorizontalButton" data-dropdown-toggle="dropdownDotsHorizontal<%= stage.id %>" class="button-default-blank-secondary-icon-only-sm" type="button">
        <i data-lucide="more-horizontal"></i>
      </button>
      <div class="p-0 w-6 rounded-tr-lg absolute border-t border-r left-[285px] bg-light-palette-p5 rotate-45" style="border-color: <%= stage_border %>;">
        <i data-lucide="chevron-right" class="-rotate-45 w-5" style="color: <%= stage_grad_to %>;"></i>
      </div>
    </div>
    <!-- Dropdown menu -->
    <div id="dropdownDotsHorizontal<%= stage.id %>" class="z-10 hidden left-16 bg-white divide-y divide-gray-300 rounded-lg shadow w-48" data-turbo-permanent>
      <ul class="py-2 typography-text-m-lh150 text-dark-gray-palette-p3 " aria-labelledby="dropdownDefaultButton">
        <li>
          <%= link_to bulk_action_account_pipeline_path(Current.account, stage.pipeline.id, stage_id: stage.id, filter: @filter), class: "flex items-center space-x-2 px-4 py-2 hover:bg-gray-300 hover:text-dark-gray-palette-p1", data: { turbo_frame: 'modal' } do %>
            <i data-lucide="layers"></i>
            <p>
              <%= t('views.accounts.pipelines.stage.bulk_action') %>
              <b class="typography-micro-b-lh150 text-dark-palette-p3 text-[6px]"> BETA </b>
            </p>
          <% end %>
        </li>
        <li>
          <%= link_to account_pipeline_import_path(Current.account, stage.pipeline.id, stage_id: stage.id), class: "flex items-center space-x-2 px-4 py-2 hover:bg-gray-300 hover:text-dark-gray-palette-p1", data: { turbo_frame: :modal } do %>
            <i data-lucide="file-input"></i>
            <p>
              <%= t('views.accounts.pipelines.stage.import_deals') %>
            </p>
          <% end %>
        </li>
        <%# <li>
      <a href="#" class="flex items-center space-x-2 px-4 py-2 hover:bg-gray-300 hover:text-dark-gray-palette-p1" ><i data-lucide="file-output"></i>
        <p>Exportar negócios</p>
      </a>
    </li> %>
      </ul>
    </div>
    <%= render 'accounts/stages/kanban_details', stage: stage, filter: filter %>
  </div>
  <%= turbo_frame_tag "#{stage.id}_pagination_deals_#{pagy.page}", refresh: "morph", data: { controller: "drag-and-drop--deals", drag_and_drop__deals_url: "/accounts/:account_id/deals/:deal_id/drag_and_drop", drag_and_drop__deals_filter_value: filter, id: stage.id }, class: "block space-y-4 overflow-y-auto custom-scroll-list-deal h-[calc(100vh-260px)]" do %>
    <%= render partial: 'accounts/pipelines/deal', collection: deals, as: :deal %>
    <% if pagy.next.present? %>
      <%= turbo_frame_tag "#{stage.id}_pagination_deals_#{pagy.next}", src: account_stage_path(Current.account, stage, filter: filter, page: pagy.next), refresh: :morph, data: { controller: "frame drag-and-drop--deals", action: "turbo:before-frame-render->frame#morphRender turbo:before-morph-element->frame#morphReload", drag_and_drop__deals_url: "/accounts/:account_id/deals/:deal_id/drag_and_drop", drag_and_drop__deals_filter_value: filter, id: stage.id }, class: "block space-y-4 mt-4", loading: :lazy do %>
        <div class="py-5">
          <%= render '/components/loading' %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
