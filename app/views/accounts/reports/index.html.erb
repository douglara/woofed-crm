<div class="m-8">
  <div class='mb-5 flex justify-end'>
    <div class='w-1/4'>
      <%= form_with(url: account_reports_path(Current.account), method: :get, data: { turbo_frame: :summary_session, turbo_action: :advance, controller: 'form--date-range-picker' }) do |form| %>
        <%= form.text_field :date_range, class: 'form-input w-full', data: { form__date_range_picker_target: 'dateRangeForm' } %>
        <%= form.submit 'pesquisar' %>
      <% end %>
    </div>
    <%# current_user.language %>
  </div>
  <%= turbo_frame_tag :summary_session do %>
    <%= turbo_frame_tag :summary_reports, src: summary_account_reports_path(Current.account, date_range: params[:date_range]), loading: :lazy do  %>
      <%= render '/components/skeleton/event_card', from_me: true, done: false %>
      <%= render '/components/skeleton/event_card', from_me: true, done: false %>
    <% end %>
  <% end %>
</div>
