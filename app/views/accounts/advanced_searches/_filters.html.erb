<div class="flex gap-2 mb-4 flex-wrap">
  <%= link_to account_advanced_searches_path(Current.account, q: params[:q]),
        class: "search-filter-button #{params[:search_type].blank? ? 'search-filter-button-active' : ''}" do %>
    <i data-lucide="layout-grid" class="w-4 h-4"></i>
    <%= t('views.accounts.search.filters.all') %>
  <% end %>
  <%= link_to account_advanced_searches_path(Current.account, q: params[:q], search_type: 'contact'),
        class: "search-filter-button #{params[:search_type] == 'contact' ? 'search-filter-button-active' : ''}" do %>
    <i data-lucide="contact" class="w-4 h-4"></i>
    <%= t('activerecord.models.contact.other') %>
  <% end %>
  <%= link_to account_advanced_searches_path(Current.account, q: params[:q], search_type: 'deal'),
        class: "search-filter-button #{params[:search_type] == 'deal' ? 'search-filter-button-active' : ''}" do %>
    <i data-lucide="clipboard-list" class="w-4 h-4"></i>
    <%= t('activerecord.models.deal.other') %>
  <% end %>
  <%= link_to account_advanced_searches_path(Current.account, q: params[:q], search_type: 'product'),
        class: "search-filter-button #{params[:search_type] == 'product' ? 'search-filter-button-active' : ''}" do %>
    <i data-lucide="box" class="w-4 h-4"></i>
    <%= t('activerecord.models.product.other') %>
  <% end %>
  <%= link_to account_advanced_searches_path(Current.account, q: params[:q], search_type: 'pipeline'),
        class: "search-filter-button #{params[:search_type] == 'pipeline' ? 'search-filter-button-active' : ''}" do %>
    <i data-lucide="funnel" class="w-4 h-4"></i>
    <%= t('activerecord.models.pipeline.other') %>
  <% end %>
  <%= link_to account_advanced_searches_path(Current.account, q: params[:q], search_type: 'activity'),
        class: "search-filter-button #{params[:search_type] == 'activity' ? 'search-filter-button-active' : ''}" do %>
    <i data-lucide="calendar-check-2" class="w-4 h-4"></i>
    <%= Event.human_enum_name(:kind, :activity).pluralize %>
  <% end %>
</div>
