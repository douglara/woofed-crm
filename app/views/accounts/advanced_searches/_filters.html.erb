<% filters = [
  {
    value: "",
    icon: "layout-grid",
    label: t('views.accounts.advanced_searches.filters.all'),
    is_default: true
  },
  {
    value: "contact",
    icon: "contact",
    label: t('activerecord.models.contact.other')
  },
  {
    value: "deal",
    icon: "clipboard-list",
    label: t('activerecord.models.deal.other')
  },
  {
    value: "product",
    icon: "box",
    label: t('activerecord.models.product.other')
  },
  {
    value: "pipeline",
    icon: "funnel",
    label: t('activerecord.models.pipeline.other')
  },
  {
    value: "activity",
    icon: "calendar-check-2",
    label: Event.human_enum_name(:kind, :activity).pluralize
  }
]
%>
<%= f.hidden_field :search_type, value: "", data: { form__advanced_search_target: :searchTypeField } %>
<div class="flex gap-2 mb-4 flex-wrap">
  <% filters.each do |filter| %>
    <%= link_to "",
          class: "search-filter-button",
          data: {
            form__advanced_search_target: :filterButton,
            action: 'click->form--advanced-search#selectFilter',
            value: filter[:value]
          },
          aria: { selected: filter[:is_default] } do %>
      <i data-lucide="<%= filter[:icon] %>" class="w-4 h-4"></i>
      <%= filter[:label] %>
    <% end %>
  <% end %>
</div>
