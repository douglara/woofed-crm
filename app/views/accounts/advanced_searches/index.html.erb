<%= render layout: 'components/overlays/modal', locals: { title: t('views.accounts.search.title'), width_class: 'max-w-2xl' } do %>
  <div class="p-4 md:p-5" data-controller="load-lucid-icons">
    <%= render 'accounts/advanced_searches/search_form' %>
    <%= turbo_frame_tag :search_results_session do %>
      <%= turbo_frame_tag :search_results, src: search_results_account_advanced_searches_path(Current.account, q: params[:q] || ' ', search_type: params[:search_type] || ' '), loading: :lazy do  %>
        <div class="text-center py-8">
          <i data-lucide="search" class="w-12 h-12 mx-auto color-fg-extra-soft mb-2 animate-spin"></i>
          <p class="typography-text-r-lh150 color-fg-soft"><%= t('activerecord.models.processing') %></p>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
